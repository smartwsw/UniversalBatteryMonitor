<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>App\app.ico</ApplicationIcon>
    <AssemblyName>BatteryMonitor</AssemblyName>
    <RootNamespace>BatteryMonitor</RootNamespace>
    <Version>1.2.1</Version>
    <FileVersion>1.2.1.0</FileVersion>
    <Product>设备电量</Product>
    <Description>Windows 托盘外设电量监控</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 裁剪保留清单：WinForms 销毁窗口时用到的 COM 封送类型，被裁掉会导致退出时报错 -->
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <PropertyGroup>
    <!--
      裁剪发布时 .NET 默认把内置 COM（Built-in COM）关掉，而 WinForms 的
      无障碍/UI 自动化支持（AccessibleObject、UIA 事件）强依赖它。
      不打开就会在创建窗体、销毁句柄时抛
      "Built-in COM has been disabled via a feature switch"。
    -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <CustomResourceTypesSupport>true</CustomResourceTypesSupport>
  </PropertyGroup>

</Project>
